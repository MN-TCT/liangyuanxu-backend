# ============================================================
# 环境变量示例文件 —— 复制为 .env 并填入真实值
#   cp .env.example .env
# .env 已被 .gitignore 忽略，切勿提交到版本库
# ============================================================

# ---------- MySQL ----------
# 数据库 root 密码（生产环境务必改为强密码）
MYSQL_ROOT_PASSWORD=change-me-strong-password

# ---------- JWT ----------
# JWT 签名密钥，至少 32 字节随机字符串。生成方式：
#   openssl rand -base64 48
JWT_SECRET=change-me-at-least-32-bytes-random-secret-string

# ---------- 微信小程序（真机发布必填） ----------
# 未配置时开发态自动降级为模拟登录
WX_APPID=
WX_SECRET=

# ---------- 短信验证码 ----------
# true：/sms/send 返回 devCode 明文（仅本地开发）；生产必须设为 false
SMS_DEV_MODE=true
